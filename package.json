{
  "name": "vault-circle",
  "version": "0.1.0",
  "description": "A privacy-preserving digital chit fund on Midnight",
  "type": "module",
  "scripts": {
    "build": "compact compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:preprod": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsx deploy/deploy.ts preprod",
