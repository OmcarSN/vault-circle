// ═══════════════════════════════════════════════════════════════════════
// Vault Circle — Privacy-Preserving Rotating Savings Circle
// ═══════════════════════════════════════════════════════════════════════
//
// PRIVACY MODEL:
//   PUBLIC (on-chain ledger state):
//     - `requiredShare` (Uint<32>): Target contribution per member.
//     - `memberCount` (Uint<32>): Total members in the circle.
//     - `currentRecipientIndex` (Uint<32>): Index of member whose turn it is to receive payout.
//     - `membersContributedThisCycle` (Uint<32>): Count of members who've paid this cycle.
//     - `poolTotal` (Uint<32>): Running public total of funds in the pool.
//     - `cycleCount` (Uint<32>): Number of completed cycles.
//     - `poolSolvent` (Boolean): Emergency flag, whether the fund remains solvent.
//
//   PRIVATE (witness — never leaves the member's machine):
//     - `memberIndex()`: This caller's position in the rotation.
//     - `memberContribution()`: The member's actual contribution amount.
//
// ═══════════════════════════════════════════════════════════════════════

pragma language_version 0.23;

export ledger requiredShare: Uint<32>;
export ledger memberCount: Uint<32>;
export ledger currentRecipientIndex: Uint<32>;
export ledger membersContributedThisCycle: Uint<32>;
export ledger poolTotal: Uint<32>;
export ledger cycleCount: Uint<32>;
export ledger poolSolvent: Boolean;

witness memberIndex(): Uint<32>;
witness memberContribution(): Uint<32>;

// ─── KNOWN LIMITATION: identity binding (unfixed by design) ────────────
// memberIndex() and memberContribution() are client-supplied witnesses.
// Nothing cryptographically binds them to a specific wallet/member, so the
// rotation gate in claimPayout() ("idx == currentRecipientIndex") is
// self-attested: a caller proves they *claim* to be the current recipient,
// not that they *are*. A dishonest caller could assert any index.
// Closing this requires a real identity scheme — e.g. registering a
// commitment (hash of a per-member secret) at joinCircle() and proving
// knowledge of the preimage on contribute()/claimPayout() — which changes
// the ledger schema and is out of scope for the current hardening pass.

// ─── Constructor ─────────────────────────────────────────────────────
constructor(reqShare: Uint<32>) {
  requiredShare = disclose(reqShare);
  memberCount = disclose(0 as Uint<32>);
  currentRecipientIndex = disclose(0 as Uint<32>);
  membersContributedThisCycle = disclose(0 as Uint<32>);
  poolTotal = disclose(0 as Uint<32>);
  cycleCount = disclose(0 as Uint<32>);
  poolSolvent = disclose(true);
}

// ─── joinCircle ──────────────────────────────────────────────────────
// Assigns the caller a spot in the circle publicly by incrementing memberCount.
export circuit joinCircle(): [] {
  memberCount = disclose((memberCount + 1) as Uint<32>);
}

// ─── contribute ──────────────────────────────────────────────────────
// A member proves their contribution meets the required share.
// Increments the contributed count and pool total.
export circuit contribute(): [] {
  const amount = memberContribution();
  // Order matters: validate the share first so an underfunded contribution
  // reports that specific failure regardless of circle capacity.
  assert(amount >= requiredShare, "Contribution does not meet the required share");

  // Emergency stop: a fund flagged insolvent must not keep accepting money.
  assert(poolSolvent == true, "Fund is marked insolvent; contributions are frozen");

  // Cap contributions at one per member per cycle. Without this the same
  // caller (or a non-member who never joined) could pad the pool repeatedly.
  assert(membersContributedThisCycle < memberCount, "All members have already contributed this cycle");

  membersContributedThisCycle = disclose((membersContributedThisCycle + 1) as Uint<32>);
  poolTotal = disclose((poolTotal + requiredShare) as Uint<32>);
}

// ─── checkSolvency ───────────────────────────────────────────────────
// Proves poolTotal >= requiredShare * memberCount.
export circuit checkSolvency(): [] {
  assert(poolTotal >= ((requiredShare as Uint<64>) * (memberCount as Uint<64>)) as Uint<32>, "Pool is underfunded");
}

// ─── getRotationStatus ───────────────────────────────────────────────
// Proves whether the caller is the current recipient.
export circuit getRotationStatus(): Boolean {
  const idx = memberIndex();
  return disclose(idx == currentRecipientIndex);
}

// ─── claimPayout ─────────────────────────────────────────────────────
// Allows the current recipient to claim the pool.
// Advances rotation, resets cycle contributions, increments cycleCount.
export circuit claimPayout(): [] {
  const idx = memberIndex();
  assert(idx == currentRecipientIndex, "Not your turn to claim the payout");

  // Emergency stop: an insolvent fund cannot pay out.
  assert(poolSolvent == true, "Fund is marked insolvent; payouts are frozen");

  // Require all members to have contributed this cycle before payout.
  // Without this, a recipient can drain the pool early, stealing from contributors.
  assert(membersContributedThisCycle >= memberCount, "Not all members have contributed this cycle");

  // Guard against zero-member edge case that would wedge rotation at index 1.
  assert(memberCount > 0, "Cannot claim payout with zero members");

  // Advance rotation wrapping around
  const nextIdx = (currentRecipientIndex + 1) as Uint<32>;
  if (nextIdx == memberCount) {
    currentRecipientIndex = disclose(0 as Uint<32>);
  } else {
    currentRecipientIndex = disclose(nextIdx);
  }

  membersContributedThisCycle = disclose(0 as Uint<32>);
  cycleCount = disclose((cycleCount + 1) as Uint<32>);
  poolTotal = disclose(0 as Uint<32>);
}

// ─── markInsolvent ───────────────────────────────────────────────────
// Emergency override
export circuit markInsolvent(): [] {
  assert(poolSolvent == true, "Fund is already marked insolvent");
  poolSolvent = disclose(false);
}
