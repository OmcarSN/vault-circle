# Vault Circle — deploy environment (EXAMPLE)
#
# Copy this file to .env.preprod (or .env.preview) and fill in your seed.
# NEVER commit the real .env.preprod / .env.preview — they are gitignored.

# 64-character hex wallet seed. Generate one with:
#   npm run gen:seed
VAULT_CIRCLE_SEED=

# Public constructor argument: required contribution share per member per cycle.
VAULT_CIRCLE_REQUIRED_SHARE=100

# Private witness value used at deploy time (member's actual contribution).
# Never written to the ledger.
VAULT_CIRCLE_CONTRIBUTION=100
